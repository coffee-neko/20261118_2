<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.TodoMapper">

    <resultMap id="todoResultMap" type="com.example.demo.model.Todo">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="completed" column="completed"/>
    </resultMap>

    <select id="findAll" resultMap="todoResultMap">
        SELECT id, title, completed
        FROM todos
        ORDER BY id
    </select>

    <select id="findPage" resultMap="todoResultMap">
        SELECT id, title, completed
        FROM todos
        <where>
            <if test="keyword != null and keyword != ''">
                title LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="completed != null">
                AND completed = #{completed}
            </if>
        </where>
        ORDER BY id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM todos
        <where>
            <if test="keyword != null and keyword != ''">
                title LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="completed != null">
                AND completed = #{completed}
            </if>
        </where>
    </select>

    <select id="findById" parameterType="java.lang.Long" resultMap="todoResultMap">
        SELECT id, title, completed
        FROM todos
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.demo.model.Todo"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todos (title, completed)
        VALUES (#{title}, #{completed})
    </insert>

    <update id="update" parameterType="com.example.demo.model.Todo">
        UPDATE todos
        SET title = #{title},
            completed = #{completed}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM todos
        WHERE id = #{id}
    </delete>
</mapper>
